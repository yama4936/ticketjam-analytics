{
  "name": "ticketjam-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx packages/db/migrate.ts",
    "collect:once": "tsx scripts/collect-once.ts",
    "worker": "tsx apps/worker/main.ts",
    "api": "tsx apps/api/server.ts",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "reprocess": "tsx scripts/reprocess.ts",
    "reaggregate": "tsx scripts/reaggregate.ts",
    "readiness": "tsx scripts/readiness.ts",
    "publication:verify": "tsx scripts/verify-publication.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "cheerio": "1.2.0",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "robots-parser": "3.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
